# Copiar como .env y completar con valores reales. El archivo .env NO se versiona.
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secreto JWT en Base64 (mínimo 256 bits). Generar con: openssl rand -base64 64
JWT_SECRET=

FM_URL=https://<servidor-filemaker>/fmi/data/v1/databases
FM_USER=
FM_PASSWORD=
FM_DATABASE=PlastInnova_Info
# false = no verificar el certificado TLS de FileMaker (solo red interna, mientras no haya certificado válido)
FM_VERIFICAR_TLS=true
# Estados de pedido de FileMaker cuyos pedidos nuevos no se importan (separados por coma)
FM_SYNC_ESTADOS_OMITIDOS=Despachado,Entregado,Anulado
# Estados de FileMaker equivalentes a un estado local (ValorFileMaker:CODIGO_LOCAL, separados por coma)
FM_SYNC_EQUIVALENCIAS_PEDIDO=ParaAlistar:CREADO,EnAlistamiento:CREADO
FM_SYNC_EQUIVALENCIAS_DETALLE=EnAlistamiento:CREADO
# true = ejecutar la sincronización automática (cada 15 min por defecto, ver FM_SYNC_CRON)
FM_SYNC_ENABLED=false
# Opcionales: frecuencia incremental, hora de la reconciliación nocturna y margen de la búsqueda incremental
# FM_SYNC_CRON=0 */15 * * * *
# FM_SYNC_CRON_RECONCILIACION=0 0 2 * * *
# FM_SYNC_MARGEN_MINUTOS=60

# Orígenes permitidos para Angular, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200
